# Copy to /srv/crew-flow/.env on the VPS and fill in CHANGE_ME values.
# DO NOT commit the real .env to git.

# --- Domains ---
ROOT_HOST=crew-flow.eu
APP_HOST=app.crew-flow.eu
API_HOST=api.crew-flow.eu
KEYCLOAK_HOST=auth.crew-flow.eu
LOGS_HOST=logs.crew-flow.eu

# bcrypt hash of basic-auth password for Dozzle (escape every $ as $$ in this .env file)
LOGS_BASIC_AUTH_HASH=CHANGE_ME

# --- Image tag (CI updates this) ---
BACKEND_TAG=latest

# --- Managed Postgres (Scaleway) ---
DB_HOST=51.158.130.202
DB_PORT=13453

# App DB
DB_APP_NAME=crew-flow-app
DB_APP_USER=jm-crew-flow-app
DB_APP_PASSWORD=CHANGE_ME

# Keycloak DB
DB_KC_NAME=keycloak
DB_KC_USER=jm-keycloak-db
DB_KC_PASSWORD=CHANGE_ME

# --- Keycloak realm ---
KEYCLOAK_REALM=crew-flow
KEYCLOAK_ADMIN_CLIENT_ID=crew-flow-api
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_ROLES_CLIENT_ID=crew-flow

# --- Keycloak bootstrap admin (first boot only; ignored if admin user already exists in DB) ---
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
